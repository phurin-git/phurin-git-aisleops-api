generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

model Product {
  id           String            @id @default(uuid()) @db.Uuid
  code         String            @unique @db.VarChar(100)
  name         String            @db.VarChar(200)
  description  String?
  unit         String            @default("pcs") @db.VarChar(30)
  minimumStock Int               @default(0)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)
  inventory    InventoryBalance?
  movements    StockMovement[]

  @@index([name])
  @@map("products")
}

model InventoryBalance {
  productId String   @id @db.Uuid
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("inventory_balances")
}

model StockMovement {
  id             String       @id @default(uuid()) @db.Uuid
  productId      String       @db.Uuid
  type           MovementType
  quantity       Int
  balanceBefore  Int
  balanceAfter   Int
  reference      String?      @db.VarChar(120)
  note           String?
  idempotencyKey String       @unique @db.Uuid
  createdBy      String?      @db.VarChar(120)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("stock_movements")
}
